# =============================================================================
# PROJECT ZOMBOID SERVER & ADMINISTRATOR - CONFIGURACIÓN 1PANEL (.env)
# =============================================================================
# Instrucciones:
# 1. Copia este archivo a '.env':
#      cp .env.1panel.example .env
# 2. Modifica ADMIN_PASSWORD y RCON_PASSWORD con contraseñas seguras.
# 3. Inicia el stack en 1Panel o vía CLI:
#      docker compose -f docker-compose.1panel.yml up -d
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CREDENCIALES DE ACCESO Y SEGURIDAD (¡OBLIGATORIO CAMBIAR!)
# -----------------------------------------------------------------------------
# Usuario administrador para el juego y panel web
ADMIN_USERNAME=admin

# Contraseña del usuario administrador (¡CAMBIA ESTE VALOR!)
ADMIN_PASSWORD=CambiaEstaContrasena123!

# Contraseña para la consola remota RCON (usada internamente por pz-admin)
RCON_PASSWORD=SuperRconClaveSecreta99!


# -----------------------------------------------------------------------------
# 2. CONFIGURACIÓN DEL SERVIDOR PROJECT ZOMBOID (indifferentbroccoli)
# -----------------------------------------------------------------------------
# Nombre del servidor y del mundo
SERVER_NAME=pzserver

# Memoria RAM asignada en GB (mínimo recomendado: 8 GB)
MEMORY_XMX_GB=8

# Memoria inicial en GB (opcional)
MEMORY_XMS_GB=

# Argumentos JVM adicionales separados por comas (opcional)
VM_ARGS=

# Cantidad máxima de jugadores simultáneos
MAX_PLAYERS=32

# Actualizar servidor vía Steam al iniciar (true / false)
UPDATE_ON_START=true

# Rama de Steam: "" (Build 41 estable pública), "unstable" (Build 42 si disponible), etc.
SERVER_BRANCH=

# Habilitar Valve Anti-Cheat (VAC)
STEAM_VAC=true

# Integración con Steam
USE_STEAM=true

# UID y GID para permisos de archivos
PUID=1000
PGID=1000


# -----------------------------------------------------------------------------
# 3. PUERTOS DE RED Y CONECTIVIDAD
# -----------------------------------------------------------------------------
# Puerto UDP principal de Project Zomboid (abierto en firewalld)
DEFAULT_PORT=16261

# Puerto UDP secundario de Project Zomboid (abierto en firewalld)
UDP_PORT=16262

# Puerto TCP interno de RCON
RCON_PORT=27015

# Puerto del Host para pz-admin (vinculado a 127.0.0.1 para OpenResty Reverse Proxy)
# Por defecto 8088 para evitar conflicto con drawio en 8080
PZ_ADMIN_PORT=8088


# -----------------------------------------------------------------------------
# 4. RUTAS DE PERSISTENCIA (Opcional, rutas por defecto relativas)
# -----------------------------------------------------------------------------
# PZ_DATA_DIR=./server-data
# PZ_FILES_DIR=./server-files
# PZ_ADMIN_CONFIG_DIR=./admin-config


# -----------------------------------------------------------------------------
# 5. PLAYIT.GG - TÚNEL ZERO-PORT-FORWARDING (OPCIONAL)
# -----------------------------------------------------------------------------
PLAYIT_SECRET_KEY=
