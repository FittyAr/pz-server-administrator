@rendermode @(new InteractiveServerRenderMode())
@using pz_server_administrator.Services
@using pz_server_administrator.Models
@inject IConfigurationService ConfigService
@inject IAuthenticationService AuthService
@inject ILocalizationService LocService
@implements IDisposable

@using pz_server_administrator.Components.Layout

<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon">
        <FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Default" />
    </label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNav Id="main-menu" Width="250">
            <FluentNavItem Href="/" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.Home())">
                @LocService.Get("NavMenu.Home")
            </FluentNavItem>

            @* Server Config Section *@
            <FluentNavCategory Title="@LocService.Get("NavMenu.ServerConfig")" IconRest="@(new Icons.Regular.Size20.Settings())" Expanded="false">
                <FluentNavItem Href="/server-config/ini" IconRest="@(new Icons.Regular.Size20.Document())"
                    Disabled="@(!HasActiveServer)">@LocService.Get("NavMenu.IniConfig")
                </FluentNavItem>
                <FluentNavItem Href="/server-config/sandbox" IconRest="@(new Icons.Regular.Size20.Box())"
                    Disabled="@(!HasActiveServer)">@LocService.Get("NavMenu.SandboxVars")
                </FluentNavItem>
                <FluentNavItem Href="/server-config/spawn-regions" IconRest="@(new Icons.Regular.Size20.Location())"
                    Disabled="@(!HasActiveServer)">@LocService.Get("NavMenu.SpawnRegions")
                </FluentNavItem>
                <FluentNavItem Href="/server-config/spawn-points" IconRest="@(new Icons.Regular.Size20.Circle())"
                    Disabled="@(!HasActiveServer)">@LocService.Get("NavMenu.SpawnPoints")
                </FluentNavItem>
            </FluentNavCategory>

            @* RCON Section *@
            <FluentNavItem Href="/rcon" IconRest="@(new Icons.Regular.Size20.Code())"
                Disabled="@(!HasActiveServer)">@LocService.Get("NavMenu.RconConsole")</FluentNavItem>
            <FluentNavItem Href="/logs" IconRest="@(new Icons.Regular.Size20.DocumentText())"
                Disabled="@(!HasActiveServer)">@LocService.Get("NavMenu.LogsAudit")</FluentNavItem>

            @* Database Section *@
            <FluentNavItem Href="/database" IconRest="@(new Icons.Regular.Size20.Database())"
                Disabled="@(!HasActiveServer)">@LocService.Get("NavMenu.DatabaseExplorer")</FluentNavItem>

            @* Mods Section *@
            <FluentNavItem Href="/mods" IconRest="@(new Icons.Regular.Size20.Apps())"
                Disabled="@(!HasActiveServer)">@LocService.Get("NavMenu.Mods")</FluentNavItem>

            @* System Administration *@
            @if (AuthService.HasPermission(p => p.AllowUserManagement) || AuthService.HasPermission(p =>
            p.AllowConfigEdit))
            {
                <FluentNavCategory Title="@LocService.Get("NavMenu.System")" IconRest="@(new Icons.Regular.Size20.Shield())" Expanded="false">
                    @if (AuthService.HasPermission(p => p.AllowUserManagement))
                    {
                        <FluentNavItem Href="/users" IconRest="@(new Icons.Regular.Size20.People())">
                            @LocService.Get("NavMenu.UserManagement")</FluentNavItem>
                    }
                    @if (AuthService.HasPermission(p => p.AllowConfigEdit))
                    {
                        <FluentNavItem Href="/settings" IconRest="@(new Icons.Regular.Size20.SettingsChat())">
                            @LocService.Get("NavMenu.AppConfiguration")</FluentNavItem>
                    }
                </FluentNavCategory>
            }
        </FluentNav>
    </nav>
</div>

@code {
    private bool HasActiveServer => !string.IsNullOrEmpty(ConfigService.GetConfiguration().AppSettings.ActiveServer);

    protected override void OnInitialized()
    {
        AuthService.AuthenticationStateChanged += OnAuthenticationStateChanged;
        LocService.OnLanguageChanged += StateHasChanged;
    }

    private void OnAuthenticationStateChanged(AppAuthenticationState state)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        LocService.OnLanguageChanged -= StateHasChanged;
    }
}
