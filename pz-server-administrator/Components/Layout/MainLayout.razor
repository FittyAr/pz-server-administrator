@inherits LayoutComponentBase
@inject IConfigurationService ConfigService
@inject ILocalizationService LocService
@using pz_server_administrator.Components.Layout
@using pz_server_administrator.Components
@implements IDisposable

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Width="100%" Style="gap: 12px; padding: 0 4px;">
            <FluentLabel Typo="Typography.H5" Color="Color.Primary" Style="margin: 0; font-weight: 600;">
                @LocService.Get("MainLayout.Title")
            </FluentLabel>
            @if (!string.IsNullOrEmpty(ActiveServerName))
            {
                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Brand" IconStart="@(new Icons.Regular.Size16.Server())">
                    @ActiveServerName
                </FluentBadge>
            }
            else
            {
                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning" IconStart="@(new Icons.Regular.Size16.Warning())">
                    @LocService.Get("MainLayout.NoServerSelected")
                </FluentBadge>
            }
            <FluentSpacer />
            <LanguageSelector />
            <UserStatusComponent />
        </FluentStack>
    </FluentLayoutItem>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Width="100%">
        <FluentLayoutItem Area="LayoutArea.Navigation">
            <NavMenu />
        </FluentLayoutItem>
        <FluentLayoutItem Area="LayoutArea.Content" Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentLayoutItem>
    </FluentStack>
    <FluentLayoutItem Area="LayoutArea.Footer">
        <FluentLabel Typo="Typography.Body" Style="font-size: 0.85em; opacity: 0.8;">
            Project Zomboid Server Administrator
        </FluentLabel>
        <FluentSpacer />
        <a href="https://github.com/FittyAr/pz-server-administrator" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.85em;">
            <FluentIcon Value="@(new Icons.Regular.Size16.Code())" />
            GitHub
        </a>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />



<div id="blazor-error-ui" data-nosnippet>
    @LocService.Get("MainLayout.UnhandledError")
    <a href="." class="reload">@LocService.Get("MainLayout.Reload")</a>
    <span class="dismiss">🗙</span>
</div>

@inject NavigationManager NavManager

@code {
    /// <summary>
    /// Gets the name of the currently active server
    /// </summary>
    private string ActiveServerName => ConfigService.GetConfiguration().AppSettings.ActiveServer;

    /// <summary>
    /// Initializes the component and subscribes to language change events
    /// </summary>
    protected override void OnInitialized()
    {
        LocService.OnLanguageChanged += () => InvokeAsync(StateHasChanged);
        CheckSetupRequirement();
    }

    private void CheckSetupRequirement()
    {
        var config = ConfigService.GetConfiguration();
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);

        // Si no hay usuarios y no estamos ya en /setup, redirigir
        if ((config.Users == null || config.Users.Count == 0) && !uri.AbsolutePath.Equals("/setup",
        StringComparison.OrdinalIgnoreCase))
        {
            NavManager.NavigateTo("/setup");
        }
    }

    /// <summary>
    /// Disposes the component and unsubscribes from language change events
    /// </summary>
    public void Dispose()
    {
        LocService.OnLanguageChanged -= StateHasChanged;
    }
}
