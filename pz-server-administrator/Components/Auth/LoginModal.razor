@using pz_server_administrator.Models
@using pz_server_administrator.Services
@inject IAuthenticationService AuthService
@inject ILocalizationService LocService
@inject NavigationManager Navigation

@if (_isOpen)
{
    <FluentDialog @ref="_dialog" Modal="true" Style="width: 420px; max-width: 95vw;">
        <FluentDialogBody>
            <TitleTemplate>
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Gap="8">
                    <FluentIcon Value="@(new Icons.Regular.Size24.LockClosed())" Color="Color.Primary" />
                    <FluentLabel Typo="Typography.H5">@LocService.Get("Login.Title")</FluentLabel>
                </FluentStack>
            </TitleTemplate>

            <TitleActionTemplate>
                <FluentButton Appearance="ButtonAppearance.Subtle"
                              IconStart="@(new Icons.Regular.Size16.Dismiss())"
                              OnClick="HandleCancel"
                              Title="@LocService.Get("Generic.Cancel")" />
            </TitleActionTemplate>
            
            <ChildContent>
                <div class="modal-form-content">
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Error">
                                @ErrorMessage
                            </FluentMessageBar>
                        }
                        
                        <FluentTextInput @bind-Value="Username" 
                                         Placeholder="@LocService.Get("Login.Username")"
                                         Label="@LocService.Get("Login.Username")"
                                         Required="true"
                                         Autofocus="true"
                                         Style="width: 100%"
                                         @onkeydown="HandleKeyDown" />
                        
                        <FluentTextInput @bind-Value="Password" 
                                         Placeholder="@LocService.Get("Login.Password")"
                                         Label="@LocService.Get("Login.Password")"
                                         TextInputType="TextInputType.Password"
                                         Required="true"
                                         Style="width: 100%"
                                         @onkeydown="HandleKeyDown" />
                    </FluentStack>
                </div>
            </ChildContent>
            
            <ActionTemplate>
                <FluentButton Appearance="ButtonAppearance.Primary" 
                             OnClick="HandleLogin"
                             Loading="@IsLoading"
                             Disabled="@(IsLoading || string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))">
                    @if (IsLoading)
                    {
                        <FluentIcon Value="@(new Icons.Regular.Size16.ArrowClockwise())" />
                        <span>@LocService.Get("Login.LoggingIn")</span>
                    }
                    else
                    {
                        <span>@LocService.Get("Login.LoginButton")</span>
                    }
                </FluentButton>
                
                <FluentButton Appearance="ButtonAppearance.Default" 
                             OnClick="HandleCancel"
                             Disabled="@IsLoading">
                    @LocService.Get("Generic.Cancel")
                </FluentButton>
            </ActionTemplate>
        </FluentDialogBody>
    </FluentDialog>
}

@code {
    [Parameter] public EventCallback<AuthUser> OnLoginSuccess { get; set; }
    
    private FluentDialog? _dialog;
    private bool _isOpen = false;
    private string Username = string.Empty;
    private string Password = string.Empty;
    private string ErrorMessage = string.Empty;
    private bool IsLoading = false;
    
    public async Task ShowAsync()
    {
        _isOpen = true;
        ErrorMessage = string.Empty;
        StateHasChanged();
        await Task.Yield();
        if (_dialog != null)
        {
            await _dialog.ShowAsync();
        }
    }

    public async Task HideAsync()
    {
        await CloseModal();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsLoading && !string.IsNullOrWhiteSpace(Username) && !string.IsNullOrWhiteSpace(Password))
        {
            await HandleLogin();
        }
    }

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(Username) || string.IsNullOrWhiteSpace(Password))
        {
            ErrorMessage = "Por favor, complete todos los campos.";
            return;
        }
        
        IsLoading = true;
        ErrorMessage = string.Empty;
        StateHasChanged();
        
        try
        {
            var success = await AuthService.LoginAsync(Username, Password);
            if (success)
            {
                var currentUser = AuthService.CurrentState.CurrentUser;
                await CloseModal();
                ClearForm();
                await OnLoginSuccess.InvokeAsync(currentUser);
            }
            else
            {
                ErrorMessage = "Credenciales inválidas. Por favor, verifique su usuario y contraseña.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al iniciar sesión: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
    
    private async Task HandleCancel()
    {
        await CloseModal();
        ClearForm();
    }
    
    private async Task CloseModal()
    {
        if (_dialog != null)
        {
            await _dialog.HideAsync();
        }
        _isOpen = false;
        StateHasChanged();
    }
    
    private void ClearForm()
    {
        Username = string.Empty;
        Password = string.Empty;
        ErrorMessage = string.Empty;
        IsLoading = false;
    }
}
