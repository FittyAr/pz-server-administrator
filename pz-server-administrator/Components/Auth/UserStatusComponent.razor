@using pz_server_administrator.Models
@using pz_server_administrator.Services
@inject IAuthenticationService AuthService
@inject ILocalizationService LocService
@inject NavigationManager Navigation
@implements IDisposable

<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right"
    VerticalAlignment="VerticalAlignment.Center" Gap="8" Style="width: auto;">
    @if (AuthService.CurrentState.IsAuthenticated)
    {
        <FluentAvatar Name="@AuthService.CurrentState.CurrentUser?.Username"
            Size="AvatarSize.Size32"
            Initials="@GetUserInitials(AuthService.CurrentState.CurrentUser?.Username)" />

        <FluentButton Id="user-menu-button"
            IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Person())"
            Appearance="ButtonAppearance.Subtle" OnClick="ToggleUserMenu">
            @AuthService.CurrentState.CurrentUser?.Username
        </FluentButton>

        <FluentPopover AnchorId="user-menu-button" @bind-Opened="_isUserMenuOpen">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="ShowUserInfo"
                    Style="width: 100%; justify-content: flex-start;">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Info())"
                        Slot="start" />
                    @LocService.Get("UserStatus.UserInfo")
                </FluentButton>

                @if (AuthService.HasPermission(p => p.AllowConfigEdit))
                {
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="NavigateToSettings"
                        Style="width: 100%; justify-content: flex-start;">
                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Settings())"
                            Slot="start" />
                        @LocService.Get("NavMenu.AppConfiguration")
                    </FluentButton>
                }

                <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="HandleLogout"
                    Style="width: 100%; justify-content: flex-start;">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.ArrowExit())"
                        Slot="start" />
                    @LocService.Get("UserStatus.Logout")
                </FluentButton>
            </FluentStack>
        </FluentPopover>
    }
    else
    {
        <FluentButton Appearance="ButtonAppearance.Primary"
            IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.LockClosed())"
            OnClick="OpenLoginModal">
            @LocService.Get("UserStatus.Login")
        </FluentButton>
    }
</FluentStack>

<!-- In-Context Login Modal -->
<LoginModal @ref="_loginModal" />

<!-- User Info Dialog -->
@if (_isUserInfoOpen)
{
    <FluentDialog @ref="_userInfoDialog" Modal="true" Style="width: 100%; max-width: 520px;">
        <FluentDialogBody>
            <TitleTemplate>
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Gap="8">
                    <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Person())" Color="Color.Primary" />
                    <FluentLabel Typo="Typography.H5">@LocService.Get("UserStatus.UserInfoTitle")</FluentLabel>
                </FluentStack>
            </TitleTemplate>

            <TitleActionTemplate>
                <FluentButton Appearance="ButtonAppearance.Subtle"
                              IconStart="@(new Icons.Regular.Size16.Dismiss())"
                              OnClick="CloseUserInfo"
                              Title="@LocService.Get("UserStatus.Close")" />
            </TitleActionTemplate>

            <ChildContent>
                @if (AuthService.CurrentState.IsAuthenticated && AuthService.CurrentState.CurrentUser != null)
                {
                    <div class="modal-form-content">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                            <FluentCard>
                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                                    <FluentLabel Typo="Typography.Body"><strong>@LocService.Get("UserStatus.Username"):</strong>
                                        @AuthService.CurrentState.CurrentUser.Username</FluentLabel>
                                    <FluentLabel Typo="Typography.Body"><strong>@LocService.Get("UserStatus.Role"):</strong>
                                        @GetRoleDisplayName(AuthService.CurrentState.CurrentRole)</FluentLabel>
                                    <FluentLabel Typo="Typography.Body"><strong>@LocService.Get("UserStatus.Status"):</strong>
                                        @(AuthService.CurrentState.CurrentUser.IsActive ? LocService.Get("UserStatus.Active") :
                                            LocService.Get("UserStatus.Inactive"))</FluentLabel>
                                    <FluentLabel Typo="Typography.Body"><strong>@LocService.Get("UserStatus.Created"):</strong>
                                        @AuthService.CurrentState.CurrentUser.CreatedAt.ToString("dd/MM/yyyy HH:mm")</FluentLabel>
                                    @if (AuthService.CurrentState.CurrentUser.LastLoginAt.HasValue)
                                    {
                                        <FluentLabel Typo="Typography.Body"><strong>@LocService.Get("UserStatus.LastLogin"):</strong>
                                            @AuthService.CurrentState.CurrentUser.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm")
                                        </FluentLabel>
                                    }
                                    <FluentLabel Typo="Typography.Body"><strong>@LocService.Get("UserStatus.SessionStarted"):</strong>
                                        @AuthService.CurrentState.SessionStartTime?.ToString("dd/MM/yyyy HH:mm")</FluentLabel>
                                </FluentStack>
                            </FluentCard>

                            <FluentCard>
                                <FluentLabel Typo="Typography.H6">@LocService.Get("UserStatus.Permissions"):</FluentLabel>
                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                                    @foreach (var permission in AuthService.CurrentState.CurrentPermissions.GetPermissionsDictionary())
                                    {
                                        <FluentLabel Typo="Typography.Body">
                                            <FluentIcon
                                                Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Checkmark())"
                                                Color="Color.Success" />
                                            @GetPermissionDisplayName(permission.Key): @(permission.Value ?
                                    LocService.Get("UserStatus.Allowed") : LocService.Get("UserStatus.Denied"))
                                        </FluentLabel>
                                    }
                                </FluentStack>
                            </FluentCard>
                        </FluentStack>
                    </div>
                }
            </ChildContent>

            <ActionTemplate>
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="CloseUserInfo">
                    @LocService.Get("UserStatus.Close")
                </FluentButton>
            </ActionTemplate>
        </FluentDialogBody>
    </FluentDialog>
}

@code {
    private FluentDialog? _userInfoDialog;
    private LoginModal? _loginModal;
    private bool _isUserMenuOpen = false;
    private bool _isUserInfoOpen = false;

    protected override void OnInitialized()
    {
        AuthService.AuthenticationStateChanged += OnAuthenticationStateChanged;
        LocService.OnLanguageChanged += StateHasChanged;
    }

    private void OnAuthenticationStateChanged(AppAuthenticationState state)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OpenLoginModal()
    {
        if (_loginModal != null)
        {
            await _loginModal.ShowAsync();
        }
        else
        {
            Navigation.NavigateTo("/login");
        }
    }

    private void NavigateToSettings()
    {
        _isUserMenuOpen = false;
        Navigation.NavigateTo("/settings");
    }

    private async Task HandleLogout()
    {
        _isUserMenuOpen = false;
        await AuthService.LogoutAsync();
    }

    private async Task ShowUserInfo()
    {
        _isUserMenuOpen = false;
        _isUserInfoOpen = true;
        StateHasChanged();
        await Task.Yield();
        if (_userInfoDialog != null)
        {
            await _userInfoDialog.ShowAsync();
        }
    }

    private void ToggleUserMenu()
    {
        _isUserMenuOpen = !_isUserMenuOpen;
    }

    private async Task CloseUserInfo()
    {
        if (_userInfoDialog != null)
        {
            await _userInfoDialog.HideAsync();
        }
        _isUserInfoOpen = false;
        StateHasChanged();
    }

    private string GetRoleDisplayName(UserRole role)
    {
        return role switch
        {
            UserRole.Administrator => LocService.Get("UserRole.Administrator"),
            UserRole.Moderator => LocService.Get("UserRole.Moderator"),
            UserRole.Guest => LocService.Get("UserRole.Guest"),
            _ => LocService.Get("UserRole.Unknown")
        };
    }

    private string GetUserInitials(string? username)
    {
        if (string.IsNullOrEmpty(username))
            return "?";

        var parts = username.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        else if (parts.Length == 1 && parts[0].Length >= 2)
            return parts[0].Substring(0, 2).ToUpper();
        else
            return parts[0][0].ToString().ToUpper();
    }

    private string GetPermissionDisplayName(string permission)
    {
        return permission switch
        {
            "CanEditConfig" => LocService.Get("Permission.CanEditConfig"),
            "CanUseRcon" => LocService.Get("Permission.CanUseRcon"),
            "CanManageMods" => LocService.Get("Permission.CanManageMods"),
            "CanWriteDatabase" => LocService.Get("Permission.CanWriteDatabase"),
            _ => permission
        };
    }

    public void Dispose()
    {
        AuthService.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        LocService.OnLanguageChanged -= StateHasChanged;
    }
}
