@page "/users"
@using pz_server_administrator.Services
@using pz_server_administrator.Models
@using pz_server_administrator.Components.Auth
@using Microsoft.FluentUI.AspNetCore.Components.Icons
@inject IAuthenticationService AuthService
@inject IPasswordHashingService PasswordHashingService
@inject ILocalizationService LocService

<PageTitle>@LocService.Get("UserManagement.Title") - PZ Server Administrator</PageTitle>

<AuthorizedView RequiredPermission="AllowUserManagement">
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="24">
            <!-- Header -->
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="4">
                    <FluentLabel Typo="Typography.H3">
                        <FluentIcon
                            Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.People())" />
                        @LocService.Get("UserManagement.Title")
                    </FluentLabel>
                    <FluentLabel Typo="Typography.Body">@LocService.Get("UserManagement.Description")</FluentLabel>
                </FluentStack>

                <FluentButton Appearance="ButtonAppearance.Primary"
                    IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.PersonAdd())"
                    OnClick="ShowCreateUserDialog">
                    @LocService.Get("UserManagement.CreateUser")
                </FluentButton>
            </FluentStack>

            <!-- Users Table -->
            <FluentCard>
                <FluentDataGrid Items="@Users" GridTemplateColumns="1fr 1fr 1fr 1fr 1fr auto" Style="width: 100%;">
                    <PropertyColumn Property="@(u => u.Username)"
                        Title="@LocService.Get("UserManagement.Table.Username")" Sortable="true" />
                    <PropertyColumn Property="@(u => GetRoleDisplayName(u.Role))"
                        Title="@LocService.Get("UserManagement.Table.Role")" Sortable="true" />
                    <PropertyColumn
                        Property="@(u => u.IsActive ? LocService.Get("UserManagement.Table.Active") : LocService.Get("UserManagement.Table.Inactive"))"
                        Title="@LocService.Get("UserManagement.Table.Status")" Sortable="true">
                        <ColumnOptions>
                            <div class="search-box">
                                <FluentTextInput TextInputType="TextInputType.Search" Autofocus=false @bind-Value=statusFilter
                                    @oninput="HandleStatusFilter" Placeholder="Filtrar por estado..." />
                            </div>
                        </ColumnOptions>
                    </PropertyColumn>
                    <PropertyColumn Property="@(u => u.CreatedAt.ToString("dd/MM/yyyy"))"
                        Title="@LocService.Get("UserManagement.Table.Created")" Sortable="true" />
                    <PropertyColumn
                        Property="@(u => u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : LocService.Get("UserManagement.Table.Never"))"
                        Title="@LocService.Get("UserManagement.Table.LastLogin")" Sortable="true" />
                    <TemplateColumn Title="@LocService.Get("UserManagement.Table.Actions")">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                            <FluentButton Appearance="ButtonAppearance.Subtle"
                                IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Edit())"
                                OnClick="() => ShowEditUserDialog(context)" Title="Editar usuario" />

                            @if (context.Username != AuthService.CurrentState.CurrentUser?.Username)
                            {
                                <FluentButton Appearance="ButtonAppearance.Subtle"
                                    IconStart="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Delete())"
                                    OnClick="() => ShowDeleteConfirmation(context)"
                                    Title='@(LocService.Get("UserManagement.DeleteDialog.Delete") + " usuario")' />
                            }
                        </FluentStack>
                    </TemplateColumn>
                </FluentDataGrid>
            </FluentCard>
        </FluentStack>

        <!-- Create/Edit User Dialog -->
        <FluentDialog @ref="_userDialog" Modal="true">
            <FluentDialogBody>
                <TitleTemplate>
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Gap="8">
                        @if (IsEditMode)
                        {
                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.PersonEdit())" />
                        }
                        else
                        {
                            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.PersonAdd())" />
                        }
                        <FluentLabel Typo="Typography.H5">@(IsEditMode ?
                            LocService.Get("UserManagement.Dialog.EditUser") :
                            LocService.Get("UserManagement.Dialog.CreateUser"))</FluentLabel>
                    </FluentStack>
                </TitleTemplate>

                <ChildContent>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                        @if (!string.IsNullOrEmpty(DialogErrorMessage))
                        {
                            <FluentMessageBar Intent="MessageBarIntent.Error">
                                @DialogErrorMessage
                            </FluentMessageBar>
                        }

                        <FluentTextInput @bind-Value="DialogUsername"
                            Label="@LocService.Get("UserManagement.Dialog.Username")" Required="true" Disabled="@IsEditMode"
                            Style="width: 100%" />

                        @if (!IsEditMode || !string.IsNullOrEmpty(DialogPassword))
                        {
                            <FluentTextInput @bind-Value="DialogPassword"
                                Label="@(IsEditMode ? LocService.Get("UserManagement.Dialog.NewPassword") : LocService.Get("UserManagement.Dialog.Password"))"
                                TextInputType="TextInputType.Password" Required="@(!IsEditMode)" Style="width: 100%" />
                        }

                        <FluentSelect TOption="(string Value, string Label)" TValue="string" @bind-Value="DialogRole"
                            Label="@LocService.Get("UserManagement.Dialog.Role")" Style="width: 100%" Items="@_roleOptions"
                            OptionText="@(r => r.Label)" OptionValue="@(r => r.Value)" />

                        <FluentCheckbox @bind-Value="DialogIsActive"
                            Label="@LocService.Get("UserManagement.Dialog.ActiveUser")" />
                    </FluentStack>
                </ChildContent>

                <ActionTemplate>
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveUser" Loading="@IsDialogLoading"
                        Disabled="@(IsDialogLoading || string.IsNullOrWhiteSpace(DialogUsername) || (!IsEditMode && string.IsNullOrWhiteSpace(DialogPassword)))">
                        @(IsEditMode ? LocService.Get("UserManagement.Dialog.Update") :
                            LocService.Get("UserManagement.Dialog.Create"))
                    </FluentButton>

                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="CloseUserDialog" Disabled="@IsDialogLoading">
                        @LocService.Get("UserManagement.Dialog.Cancel")
                    </FluentButton>
                </ActionTemplate>
            </FluentDialogBody>
        </FluentDialog>

        <!-- Delete Confirmation Dialog -->
        <FluentDialog @ref="_deleteDialog" Modal="true">
            <FluentDialogBody>
                <TitleTemplate>
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Gap="8">
                        <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size24.Warning())"
                            Color="Color.Error" />
                        <FluentLabel Typo="Typography.H5">@LocService.Get("UserManagement.DeleteDialog.Title")</FluentLabel>
                    </FluentStack>
                </TitleTemplate>

                <ChildContent>
                    <FluentLabel Typo="Typography.Body">
                        @string.Format(LocService.Get("UserManagement.DeleteDialog.Message"), UserToDelete?.Username)
                        @LocService.Get("UserManagement.DeleteDialog.Warning")
                    </FluentLabel>
                </ChildContent>

                <ActionTemplate>
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="ConfirmDeleteUser" Loading="@IsDeleteLoading">
                        Eliminar
                    </FluentButton>

                    <FluentButton Appearance="ButtonAppearance.Default" OnClick="CancelDelete" Disabled="@IsDeleteLoading">
                        Cancelar
                    </FluentButton>
                </ActionTemplate>
            </FluentDialogBody>
        </FluentDialog>
    </ChildContent>

    <NotAuthorizedContent>
        <FluentMessageBar Intent="MessageBarIntent.Warning">
            <FluentIcon Value="@(new Microsoft.FluentUI.AspNetCore.Components.Icons.Regular.Size16.Warning())"
                Slot="start" />
            @LocService.Get("UserManagement.NoPermission")
        </FluentMessageBar>
    </NotAuthorizedContent>
</AuthorizedView>

@code {
    private IQueryable<AuthUser> Users = new List<AuthUser>().AsQueryable();
    private string statusFilter = string.Empty;

    private readonly List<(string Value, string Label)> _roleOptions = new()
    {
        (UserRole.Guest.ToString(), "Invitado"),
        (UserRole.Moderator.ToString(), "Moderador"),
        (UserRole.Administrator.ToString(), "Administrador"),
    };

    // Dialog state
    private FluentDialog? _userDialog;
    private FluentDialog? _deleteDialog;
    private bool IsEditMode = false;
    private bool IsDialogLoading = false;
    private bool IsDeleteLoading = false;
    private string DialogErrorMessage = string.Empty;

    // Dialog form data
    private string DialogUsername = string.Empty;
    private string DialogPassword = string.Empty;
    private string DialogRole = UserRole.Guest.ToString();
    private bool DialogIsActive = true;
    private AuthUser? EditingUser = null;
    private AuthUser? UserToDelete = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            var usersList = await AuthService.GetAllUsersAsync();
            Users = usersList.AsQueryable();
            StateHasChanged();
        }
        catch (Exception)
        {
            // Error loading users: log to console or handle appropriately
        }
    }

    private void HandleStatusFilter(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? string.Empty;
    }

    private async Task ShowCreateUserDialog()
    {
        IsEditMode = false;
        DialogUsername = string.Empty;
        DialogPassword = string.Empty;
        DialogRole = UserRole.Guest.ToString();
        DialogIsActive = true;
        DialogErrorMessage = string.Empty;
        EditingUser = null;
        if (_userDialog != null)
            await _userDialog.ShowAsync();
    }

    private async Task ShowEditUserDialog(AuthUser user)
    {
        IsEditMode = true;
        DialogUsername = user.Username;
        DialogPassword = string.Empty;
        DialogRole = user.Role.ToString();
        DialogIsActive = user.IsActive;
        DialogErrorMessage = string.Empty;
        EditingUser = user;
        if (_userDialog != null)
            await _userDialog.ShowAsync();
    }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(DialogUsername))
        {
            DialogErrorMessage = "El nombre de usuario es requerido.";
            return;
        }

        if (!IsEditMode && string.IsNullOrWhiteSpace(DialogPassword))
        {
            DialogErrorMessage = "La contraseña es requerida para nuevos usuarios.";
            return;
        }

        IsDialogLoading = true;
        DialogErrorMessage = string.Empty;
        StateHasChanged();

        try
        {
            if (IsEditMode && EditingUser != null)
            {
                var passwordToUpdate = string.IsNullOrWhiteSpace(DialogPassword) ? null : DialogPassword;
                await AuthService.UpdateUserAsync(EditingUser.Username, passwordToUpdate, Enum.Parse<UserRole>(DialogRole),
                DialogIsActive);
            }
            else
            {
                await AuthService.CreateUserAsync(DialogUsername, DialogPassword, Enum.Parse<UserRole>(DialogRole));
            }

            await LoadUsers();
            await CloseUserDialog();
        }
        catch (Exception ex)
        {
            DialogErrorMessage = $"Error al {(IsEditMode ? "actualizar" : "crear")} usuario: {ex.Message}";
        }
        finally
        {
            IsDialogLoading = false;
            StateHasChanged();
        }
    }

    private async Task CloseUserDialog()
    {
        if (_userDialog != null)
            await _userDialog.HideAsync();
        DialogErrorMessage = string.Empty;
        IsDialogLoading = false;
    }

    private async Task ShowDeleteConfirmation(AuthUser user)
    {
        UserToDelete = user;
        if (_deleteDialog != null)
            await _deleteDialog.ShowAsync();
    }

    private async Task ConfirmDeleteUser()
    {
        if (UserToDelete == null) return;

        IsDeleteLoading = true;
        StateHasChanged();

        try
        {
            await AuthService.DeleteUserAsync(UserToDelete.Username);
            await LoadUsers();
            await CancelDelete();
        }
        catch (Exception)
        {
            // Error deleting user: log to console or handle appropriately
        }
        finally
        {
            IsDeleteLoading = false;
            StateHasChanged();
        }
    }

    private async Task CancelDelete()
    {
        if (_deleteDialog != null)
            await _deleteDialog.HideAsync();
        UserToDelete = null;
        IsDeleteLoading = false;
    }

    private string GetRoleDisplayName(UserRole role)
    {
        return role switch
        {
            UserRole.Administrator => "Administrador",
            UserRole.Moderator => "Moderador",
            UserRole.Guest => "Invitado",
            _ => "Desconocido"
        };
    }
}
