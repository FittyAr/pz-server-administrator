    private async Task ScanModsAsync()
    {
        _isScanning = true;
        try
        {
            var config = ConfigService.GetConfiguration();
            var serverDir = config?.AppSettings?.ServerDirectoryPath;

            if (string.IsNullOrEmpty(serverDir) || !Directory.Exists(serverDir))
            {
                await NotificationService.ShowErrorAsync(LocService.Get("Mods.ScanError.NoServerDir"));
                return;
            }

            var possibleWorkshopPaths = new List<string> {
                config?.AppSettings?.WorkshopDirectoryPath ?? "",
                Environment.GetEnvironmentVariable("PZ_WORKSHOP_DIR") ?? "",
                "/project-zomboid-files/steamapps/workshop",
                "/project-zomboid-files/Workshop",
                "/project-zomboid/steamapps/workshop",
                "/project-zomboid/Workshop",
                Path.Combine(Directory.GetParent(serverDir)?.FullName ?? "", "Workshop"),
                Path.GetFullPath(Path.Combine(serverDir, "../../Workshop")),
                Path.Combine(serverDir, "Workshop")
            };

            foreach (var workshopPath in possibleWorkshopPaths)
            {
                if (!string.IsNullOrWhiteSpace(workshopPath) && Directory.Exists(workshopPath))
                {
                    await ModDiscovery.DiscoverLocalModsAsync(workshopPath);
                    await LoadDataAsync();
                    await NotificationService.ShowSuccessAsync(LocService.Get("Mods.ScanSuccess"));
                    return;
                }
            }

            await NotificationService.ShowWarningAsync(LocService.Get("Mods.NoModsFound"));
        }
        catch (Exception ex)
        {
            await NotificationService.ShowErrorAsync($"{LocService.Get("Mods.ScanError")}: {ex.Message}");
        }
        finally
        {
            _isScanning = false;
        }
    }

