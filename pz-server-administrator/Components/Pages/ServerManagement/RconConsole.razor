@page "/rcon"
@using Microsoft.FluentUI.AspNetCore.Components
@using pz_server_administrator.Services
@inject IRconService RconService
@inject IPzServerService PzServerService
@inject IConfigurationService ConfigurationService
@inject INotificationService NotificationService
@inject ILocalizationService LocService
@implements IDisposable

<PageTitle>@LocService.Get("NavMenu.RconConsole") - Project Zomboid Server Administrator</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20" Style="height: calc(100vh - 120px);">
    <!-- Header -->
    <div style="background: var(--neutral-fill-layer-rest); padding: 20px; border-radius: 8px; border-left: 6px solid @(_isConnected ? "var(--success)" : "var(--error)"); box-shadow: var(--elevation-shadow-card-rest);">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Stretch" VerticalAlignment="VerticalAlignment.Center" Wrap="true" Style="gap: 15px;">
            <div style="background: @(_isConnected ? "var(--success)" : "var(--error)"); padding: 12px; border-radius: 50%; color: white; display: flex;">
                <FluentIcon Value="@(new Icons.Filled.Size24.Stream())" />
            </div>
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                <FluentLabel Typo="Typography.H3" Style="margin: 0;">@LocService.Get("NavMenu.RconConsole")</FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="opacity: 0.7;">@LocService.Get("Rcon.Subtitle")</FluentLabel>
            </FluentStack>
            <FluentSpacer />
            
            @if (_isConnected)
            {
                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">@LocService.Get("Rcon.ConnectedTo", $"{_currentHost}:{_currentPort}")</FluentBadge>
                <FluentButton IconStart="@(new Icons.Regular.Size16.PlugDisconnected())" OnClick="DisconnectRcon" Appearance="ButtonAppearance.Subtle">@LocService.Get("Rcon.Disconnect")</FluentButton>
            }
            else
            {
                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning">@LocService.Get("Rcon.Disconnected")</FluentBadge>
                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="5">
                    <FluentSelect TOption="string" TValue="string" @bind-Value="@_selectedHostOption" Style="width: 260px;" Disabled="@_isConnecting">
                        @if (!string.IsNullOrEmpty(_configuredHost))
                        {
                            <FluentOption TValue="string" Value="@("configured")">@LocService.Get("Rcon.ServerConfigured", _configuredHost)</FluentOption>
                        }
                        @if (!string.IsNullOrEmpty(_detectedIp))
                        {
                            <FluentOption TValue="string" Value="@("auto")">@LocService.Get("Rcon.LocalNetwork", _detectedIp)</FluentOption>
                        }
                        <FluentOption TValue="string" Value="@("docker")">Docker/Podman: host.containers.internal</FluentOption>
                        <FluentOption TValue="string" Value="@("local")">Localhost: 127.0.0.1</FluentOption>
                        <FluentOption TValue="string" Value="@("custom")">@LocService.Get("Rcon.OtherHost")</FluentOption>
                    </FluentSelect>

                    @if (_selectedHostOption == "custom")
                    {
                        <FluentTextInput @bind-Value="@_customHostInput" Placeholder="Ej: 192.168.1.5" Style="width: 140px;" Disabled="@_isConnecting" />
                    }

                    <FluentButton IconStart="@(new Icons.Regular.Size16.PlugConnected())" 
                                  OnClick="ConnectRcon" 
                                  Appearance="ButtonAppearance.Primary" 
                                  Loading="@_isConnecting"
                                  Disabled="@_isConnecting">
                        @(_isConnecting ? LocService.Get("Rcon.Connecting") : LocService.Get("Rcon.Connect"))
                    </FluentButton>
                </FluentStack>
            }
        </FluentStack>
    </div>

    <!-- Console Output -->
    <FluentCard Style="padding: 0; overflow: hidden; border-radius: 8px; flex-grow: 1; display: flex; flex-direction: column;">
        <div style="padding: 10px; background: var(--neutral-fill-secondary-rest); border-bottom: 1px solid var(--neutral-stroke-rest); display: flex; justify-content: space-between;">
            <FluentLabel Typo="Typography.Body" Style="font-size: 0.8em; opacity: 0.8;">@LocService.Get("Rcon.ConsoleOutput")</FluentLabel>
            <FluentButton IconStart="@(new Icons.Regular.Size16.Delete())" Appearance="ButtonAppearance.Subtle" OnClick="ClearConsole">@LocService.Get("Rcon.Clear")</FluentButton>
        </div>
        <div style="flex-grow: 1; background: #1e1e1e; padding: 15px; overflow-y: auto; font-family: 'Consolas', monospace; font-size: 14px; display: flex; flex-direction: column;" id="rcon-console-output">
            @foreach (var log in _consoleLogs)
            {
                <span style="color: @(log.IsError ? "#ff5555" : (log.IsCommand ? "#55ff55" : "#cccccc")); margin-bottom: 4px; white-space: pre-wrap;">@log.Message</span>
            }
        </div>
    </FluentCard>

    <!-- Command Input -->
    <div style="display: flex; gap: 10px; align-items: stretch;">
        <FluentTextInput @bind-Value="@_commandInput" Placeholder="@LocService.Get("Rcon.CommandPlaceholder")" Style="flex-grow: 1;" Disabled="@(!_isConnected)" @onkeyup="HandleKeyUp" />
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Send())" Disabled="@(!_isConnected || string.IsNullOrWhiteSpace(_commandInput))" OnClick="SendCommand">@LocService.Get("Rcon.Send")</FluentButton>
    </div>
    
    <!-- Quick Commands -->
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10">
        <FluentButton Disabled="@(!_isConnected)" OnClick="@(() => SendQuickCommand("help"))" Appearance="ButtonAppearance.Outline">Help</FluentButton>
        <FluentButton Disabled="@(!_isConnected)" OnClick="@(() => SendQuickCommand("players"))" Appearance="ButtonAppearance.Outline">Players</FluentButton>
        <FluentButton Disabled="@(!_isConnected)" OnClick="@(() => SendQuickCommand("save"))" Appearance="ButtonAppearance.Outline">@LocService.Get("Rcon.SaveWorld")</FluentButton>
        <FluentButton Disabled="@(!_isConnected)" OnClick="@(() => SendQuickCommand("quit"))" Color="Color.Error" Appearance="ButtonAppearance.Outline">@LocService.Get("Rcon.QuitServer")</FluentButton>
    </FluentStack>

    <!-- Troubleshooting Documentation -->
    <FluentAccordion Style="margin-top: 10px;">
        <FluentAccordionItem>
            <HeaderTemplate>
                <span style="font-weight: 600;">@LocService.Get("Rcon.TroubleshootingTitle")</span>
            </HeaderTemplate>
            <ChildContent>
                <div style="padding: 10px; font-size: 0.9em; line-height: 1.5;">
                    <p><strong>@LocService.Get("Rcon.TroubleshootingBasic")</strong></p>
                    <ul>
                        <li>@LocService.Get("Rcon.TroubleshootingBasicText")</li>
                    </ul>
                    
                    <p><strong>@LocService.Get("Rcon.TroubleshootingNative")</strong></p>
                    <ul>
                        <li>@LocService.Get("Rcon.TroubleshootingNativeText1")</li>
                        <li>@LocService.Get("Rcon.TroubleshootingNativeText2")</li>
                    </ul>

                    <p><strong>@LocService.Get("Rcon.TroubleshootingDocker")</strong></p>
                    <ul>
                        <li>@LocService.Get("Rcon.TroubleshootingDockerText1")</li>
                        <li><strong>@LocService.Get("Rcon.TroubleshootingSol1Title"):</strong> @LocService.Get("Rcon.TroubleshootingSol1Text")</li>
                        <li><strong>@LocService.Get("Rcon.TroubleshootingSol2Title"):</strong> @LocService.Get("Rcon.TroubleshootingSol2Text") <br/><code>New-NetFirewallRule -DisplayName "Docker/Podman Subnet" -Direction Inbound -Action Allow -Protocol TCP -RemoteAddress 10.89.0.0/16</code></li>
                        <li><strong>@LocService.Get("Rcon.TroubleshootingSol3Title"):</strong> @LocService.Get("Rcon.TroubleshootingSol3Text") <br/><code>netsh interface portproxy add v4tov4 listenaddress=0.0.0.0 listenport=27015 connectaddress=127.0.0.1 connectport=27015</code></li>
                    </ul>
                </div>
            </ChildContent>
        </FluentAccordionItem>
    </FluentAccordion>
</FluentStack>

@code {
    private struct RconLog
    {
        public string Message { get; set; }
        public bool IsCommand { get; set; }
        public bool IsError { get; set; }
    }

    private string _commandInput = string.Empty;
    private bool _isConnected => RconService.IsConnected;
    private List<RconLog> _consoleLogs = new();
    
    private string _selectedHostOption = "auto";
    private string _customHostInput = "";
    private string _configuredHost = "";
    
    private string _currentHost = "";
    private int _currentPort = 27015;
    private bool _isConnecting = false;
    private string _detectedIp = "";
    
    // Inject JS runtime to scroll down automatically
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    protected override void OnInitialized()
    {
        LocService.OnLanguageChanged += StateHasChanged;
        RconService.OnConnectionStateChanged += UpdateState;
        RconService.OnMessageReceived += HandleIncomingMessage;
        
        var config = ConfigurationService.GetConfiguration();
        _configuredHost = config.AppSettings?.Rcon?.Host ?? "";

        _detectedIp = DetectLocalIp();

        if (!string.IsNullOrEmpty(_configuredHost))
        {
            _selectedHostOption = "configured";
        }
        else if (!string.IsNullOrEmpty(_detectedIp))
        {
            _selectedHostOption = "auto";
        }
        else
        {
            _selectedHostOption = "docker";
        }
    }

    private string DetectLocalIp()
    {
        try
        {
            using (var socket = new System.Net.Sockets.Socket(System.Net.Sockets.AddressFamily.InterNetwork, System.Net.Sockets.SocketType.Dgram, 0))
            {
                socket.Connect("8.8.8.8", 65530);
                if (socket.LocalEndPoint is System.Net.IPEndPoint endPoint)
                {
                    return endPoint.Address.ToString();
                }
            }
        }
        catch
        {
            try
            {
                var host = System.Net.Dns.GetHostEntry(System.Net.Dns.GetHostName());
                foreach (var ip in host.AddressList)
                {
                    if (ip.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork && !System.Net.IPAddress.IsLoopback(ip))
                    {
                        return ip.ToString();
                    }
                }
            }
            catch { }
        }
        return "";
    }

    private void UpdateState(bool state)
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleIncomingMessage(string message)
    {
        _consoleLogs.Add(new RconLog { Message = message, IsCommand = false, IsError = false });
        InvokeAsync(StateHasChanged);
        _ = ScrollToBottom();
    }

    private async Task ConnectRcon()
    {
        try
        {
            var config = ConfigurationService.GetConfiguration();
            var serverPath = config.AppSettings.ServerDirectoryPath;
            var activeServer = config.AppSettings.ActiveServer;

            var credentials = await PzServerService.GetRconCredentialsAsync(serverPath, activeServer);
            var port = credentials.port != 0 ? credentials.port : (config.AppSettings.Rcon.Port != 0 ? config.AppSettings.Rcon.Port : 27015);
            var password = !string.IsNullOrEmpty(credentials.password) ? credentials.password : config.AppSettings.Rcon.Password;
            
            _currentPort = port;
            
            string targetRaw = _selectedHostOption switch
            {
                "configured" => _configuredHost,
                "auto" => _detectedIp,
                "docker" => "host.containers.internal",
                "local" => "127.0.0.1",
                "custom" => _customHostInput,
                _ => !string.IsNullOrEmpty(_configuredHost) ? _configuredHost : "127.0.0.1"
            };
            
            var host = string.IsNullOrWhiteSpace(targetRaw) ? "127.0.0.1" : targetRaw;
            
            if (string.IsNullOrEmpty(password))
            {
                _consoleLogs.Add(new RconLog { Message = "Error: No se ha configurado la contraseña RCON ni en el archivo .ini ni en las variables de entorno/configuración.", IsError = true });
                return;
            }

            if (_isConnecting || _isConnected) return;
            _isConnecting = true;
            StateHasChanged();

            _consoleLogs.Add(new RconLog { Message = $"Conectando a {host}:{port}...", IsCommand = false });
            
            bool connected = await RconService.ConnectAsync(host, port, password);
            
            if (connected)
            {
                _currentHost = host;
                _consoleLogs.Add(new RconLog { Message = "Conectado exitosamente y autenticado.", IsCommand = true });
                await NotificationService.ShowSuccessAsync("Conexión RCON establecida.");
            }
        }
        catch (Exception ex)
        {
            _consoleLogs.Add(new RconLog { Message = $"Excepción al conectar: {ex.Message}", IsError = true });
        }
        finally
        {
            _isConnecting = false;
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
    }

    private async Task DisconnectRcon()
    {
        await RconService.DisconnectAsync();
        _consoleLogs.Add(new RconLog { Message = "Desconectado.", IsCommand = false });
        await ScrollToBottom();
    }

    private async Task SendCommand()
    {
        if (string.IsNullOrWhiteSpace(_commandInput) || !_isConnected) return;

        string command = _commandInput;
        _commandInput = string.Empty;
        _consoleLogs.Add(new RconLog { Message = $"> {command}", IsCommand = true });
        await InvokeAsync(StateHasChanged);

        string response = await RconService.SendCommandAsync(command);
        
        if (!string.IsNullOrEmpty(response))
        {
            _consoleLogs.Add(new RconLog { Message = response, IsCommand = false });
        }
        else
        {
            _consoleLogs.Add(new RconLog { Message = "(sin respuesta)", IsCommand = false, IsError = true });
        }

        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();
    }
    
    private void SendQuickCommand(string cmd)
    {
        _commandInput = cmd;
        _ = SendCommand();
    }

    private async Task HandleKeyUp(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendCommand();
        }
    }

    private void ClearConsole()
    {
        _consoleLogs.Clear();
        StateHasChanged();
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "var el = document.getElementById('rcon-console-output'); if (el) { el.scrollTop = el.scrollHeight; }");
        }
        catch { }
    }

    public void Dispose()
    {
        RconService.OnConnectionStateChanged -= UpdateState;
        RconService.OnMessageReceived -= HandleIncomingMessage;
        LocService.OnLanguageChanged -= StateHasChanged;
    }
}
