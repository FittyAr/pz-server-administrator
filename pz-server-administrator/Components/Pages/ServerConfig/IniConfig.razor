@page "/server-config/ini"
@using Microsoft.FluentUI.AspNetCore.Components
@using pz_server_administrator.Services
@inject IConfigurationService ConfigurationService
@inject ILocalizationService LocService

<PageTitle>@LocService.Get("NavMenu.IniConfig") - Project Zomboid Server Administrator</PageTitle>

<div
    style="background: var(--neutral-fill-layer-rest); padding: 20px; border-radius: 8px; border-left: 6px solid var(--accent-fill-rest); margin-bottom: 20px;">
    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="15" VerticalAlignment="VerticalAlignment.Center">
        <div
            style="background: var(--accent-fill-rest); padding: 12px; border-radius: 50%; color: white; display: flex;">
            <FluentIcon Value="@(new Icons.Filled.Size24.Settings())" />
        </div>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
            <FluentLabel Typo="Typography.H3" Style="margin: 0;">@LocService.Get("IniConfig.Title")</FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="opacity: 0.7;">@LocService.Get("IniConfig.Description")</FluentLabel>
        </FluentStack>
    </FluentStack>
</div>

@if (!string.IsNullOrEmpty(_iniPath))
{
    <ConfigEditorComponent FilePath="@_iniPath" />
}
else
{
    <FluentMessageBar Title="@LocService.Get("Generic.Error")" Intent="@MessageBarIntent.Error">
        @LocService.Get("IniConfig.FileNotFound")
    </FluentMessageBar>
}


@code {
    private string? _iniPath;



    protected override void OnInitialized()
    {
        var config = ConfigurationService.GetConfiguration();

        if (!string.IsNullOrEmpty(config.AppSettings.ServerIniPath) && File.Exists(config.AppSettings.ServerIniPath))
        {
            _iniPath = config.AppSettings.ServerIniPath;
        }
        else
        {
            var serverPath = config.AppSettings.ServerDirectoryPath;
            var activeServer = config.AppSettings.ActiveServer;

            if (!string.IsNullOrEmpty(serverPath) && !string.IsNullOrEmpty(activeServer))
            {
                _iniPath = Path.Combine(serverPath, $"{activeServer}.ini");
            }
        }
    }
}
