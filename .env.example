# =============================================================================
# PROJECT ZOMBOID SERVER & ADMINISTRATOR - PLANTILLA DE CONFIGURACIÓN (.env)
# =============================================================================
# Instrucciones:
# 1. Copia este archivo con el nombre '.env':
#      cp .env.example .env
# 2. Modifica las contraseñas obligatorias (ADMIN_PASSWORD y RCON_PASSWORD).
# 3. Inicia toda la infraestructura con:
#      docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CREDENCIALES DE ACCESO Y SEGURIDAD (¡OBLIGATORIO CAMBIAR!)
# -----------------------------------------------------------------------------
# Usuario administrador para el juego y para el panel web de administración
ADMIN_USERNAME=admin

# Contraseña del usuario administrador (¡CAMBIA ESTE VALOR!)
ADMIN_PASSWORD=CambiaEstaContrasena123!

# Contraseña para la consola remota RCON (usada por el panel web para enviar comandos)
RCON_PASSWORD=SuperRconClaveSecreta99!


# -----------------------------------------------------------------------------
# 2. CONFIGURACIÓN DEL SERVIDOR PROJECT ZOMBOID (indifferentbroccoli)
# Base: https://github.com/indifferentbroccoli/projectzomboid-server-docker
# -----------------------------------------------------------------------------
# Nombre del servidor y del mundo (creará Server/<SERVER_NAME>.ini y db/<SERVER_NAME>.sqlite)
SERVER_NAME=pzserver

# Asignación de memoria RAM máxima en Gigabytes (Se recomienda mínimo 6-8 GB)
MEMORY_XMX_GB=8

# Asignación de memoria RAM inicial en GB (Opcional, dejar vacío para usar el valor por defecto de Java)
MEMORY_XMS_GB=

# Argumentos JVM adicionales separados por comas (Opcional)
VM_ARGS=

# Cantidad máxima de jugadores simultáneos
MAX_PLAYERS=32

# Actualizar y validar archivos del servidor vía Steam al iniciar el contenedor (true / false)
UPDATE_ON_START=true

# Rama de Steam a instalar:
# ""        -> Build 41 estable pública por defecto
# "unstable"-> Build 42 Unstable (si está disponible)
# "legacy41"-> Versión fija de Build 41
SERVER_BRANCH=

# Habilitar sistema antitrampas Valve Anti-Cheat (VAC) (true / false)
STEAM_VAC=true

# Habilitar integración y multijugador a través de Steam (true / false)
USE_STEAM=true

# Permisos de archivos (UID y GID con los que corre el proceso dentro del contenedor)
PUID=1000
PGID=1000


# -----------------------------------------------------------------------------
# 3. PUERTOS DE RED DEL SERVIDOR
# -----------------------------------------------------------------------------
# Puerto base UDP de Project Zomboid para comunicación de clientes
DEFAULT_PORT=16261

# Puerto secundario UDP de Project Zomboid
UDP_PORT=16262

# Puerto TCP para la consola remota RCON
RCON_PORT=27015


# -----------------------------------------------------------------------------
# 4. CONFIGURACIÓN DEL PANEL ADMINISTRADOR WEB (pz-admin)
# -----------------------------------------------------------------------------
# Puerto del host por el que accederás a la interfaz web (http://localhost:8080)
PZ_ADMIN_PORT=8080

# (Opcional) Rutas personalizadas si conectas el panel a otro servidor que no sea indifferentbroccoli:
# PZ_SERVER_DIR=/project-zomboid-config/Server
# PZ_ZOMBOID_DIR=/project-zomboid-config
# PZ_RCON_HOST=projectzomboid


# -----------------------------------------------------------------------------
# 5. PLAYIT.GG - TÚNEL ZERO-PORT-FORWARDING (OPCIONAL)
# Permite abrir el servidor y panel web a tus amigos sin abrir puertos en tu router
# -----------------------------------------------------------------------------
# Clave secreta generada en el dashboard de playit.gg al crear un agente tipo "Docker".
# Si la dejas vacía, al iniciar el contenedor `playit-agent` ejecuta:
#   docker compose logs playit
# y copia el enlace de "Claim URL" en tu navegador para vincularlo a tu cuenta.
PLAYIT_SECRET_KEY=
